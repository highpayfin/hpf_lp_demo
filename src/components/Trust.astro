---
import { getI18nData, type SupportedLang } from '../utils/i18n';
interface Props {
  lang?: SupportedLang;
}
const { lang = 'en' } = Astro.props;
const trustData = getI18nData(lang, 'trust');
// Section: Trust


const {
  enabled = true,
  title = "Why they trust us",
  heading = "High Pay Fin is built by a team with 15 years of experience in payments",
  paragraphs = [],
  card1_title = "Compliance Status",
  card1_text = "✓ Meets the requirements",
  card2_title = "Payment Process",
  card2_text = "Client ⭢ Bank ⭢ Seller"
} = trustData;
---

{enabled !== false && (
  <section class="block block-trust">
  <div class="container">
    <div class="wrapper">
      <div class="title-block title-block_centered desktop">
        <h2 class="title"><p>{title}</p></h2>
      </div>
      <div class="title-block mobile">
        <h2 class="title"><p set:html={title.replace(/\n/g, '<br />')} /></h2>
      </div>
      <div class="trust__parent">
        <div class="trust__child left" gsap-fade>
          <div class="content">
            <h3 class="content__title desktop"><p>{heading}</p></h3>
            <h3 class="content__title mobile"><p>{heading}</p></h3>
            <div class="content__text desktop">
              {paragraphs.map((p) => (
                <p set:html={p.replace(/\n/g, '<br />')} />
              ))}
            </div>
            <div class="content__text mobile">
              {paragraphs.map((p) => (
                <p set:html={p.replace(/\n/g, '<br />')} />
              ))}
            </div>
          </div>
        </div>
        <div class="trust__child right" gsap-fade>
          <div class="composition">
            <img class="composition__image desktop" src="/assets/img/trust-image.svg?ver=1.0.10.2" alt="Trust Infrastructure">
            <img class="composition__image mobile" src="/assets/img/trust-image_mobile.svg?ver=1.0.10.2" alt="Trust Infrastructure Mobile">
            <div class="composition__card composition__card-1">
              <img class="composition__card-image" src="/assets/img/trust-card-1-icon.svg?ver=1.0.10.2" alt="Compliance Icon">
              <div class="composition__card-info">
                <h5 class="h5 composition__card-title">{card1_title}</h5>
                <div class="composition__card-text">{card1_text}</div>
              </div>
            </div>
            <div class="composition__card composition__card-2">
              <img class="composition__card-image" src="/assets/img/trust-card-2-icon.svg?ver=1.0.10.2" alt="Payment Process Icon">
              <div class="composition__card-info">
                <h5 class="h5 composition__card-title">{card2_title}</h5>
                <div class="composition__card-text">{card2_text}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
)}
