---
// Cookie banner
---
<div class="cookie-banner" style="display: none;">
	<div class="container">
		<div class="cookie-banner__wrapper">
			<button class="cookie-banner__close" close-banner>
				<div class="cookie-banner__close-icon"></div>
			</button>
			<div class="cookie-banner__text">We use cookies to ensure the best experience on our website. If you continue to use the site, we will assume you are satisfied with it.</div>
			
<button  class="btn btn_small cookie-banner__btn" close-banner>
    <div class="btn__text">
        <div class="btn__text-up">Accept</div>
        <div class="btn__text-static">Accept</div>
    </div>
    <div class="btn__bg"></div>
</button>
<a href="/privacy-policy" class="btn btn_small btn_second cookie-banner__btn" >
    <div class="btn__text">
        <div class="btn__text-up">Privacy Policy</div>
        <div class="btn__text-static">Privacy Policy</div>
    </div>
    <div class="btn__bg"></div>
</a>		</div>
	</div>
</div>
