---
import { getI18nData, type SupportedLang } from '../utils/i18n';
interface Props {
  lang?: SupportedLang;
}
const { lang = 'en' } = Astro.props;
const dontPayData = getI18nData(lang, 'dont-pay');
// Section: DontPay


const {
  enabled = true,
  title = "Can't accept payments from Russia?",
  description = "Russian clients actively buy abroad, but most businesses lack a legal and stable way to accept rubles.",
  cta_text = "Leave a request",
  cards = []
} = dontPayData;
---

{enabled !== false && (
  <section class="block block-dont-pay">
  <div class="container">
    <div class="dont-pay__parent">
      <div class="static-test desktop">
        <div class="dont-pay__child left">
          {cards.map((card) => (
            <div class={`info-card info-card_${card.type}`}>
              <div class="info-card__icon">
                <div class="info-card__icon-blur"></div>
                <div class="info-card__icon-image"><img src={card.icon} alt={card.title}></div>
              </div>
              <h3 class="h3 info-card__title"><p set:html={card.title.replace(/\n/g, '<br />')} /></h3>
              <div class="info-card__text"><p set:html={card.text.replace(/\n/g, '<br />')} /></div>
            </div>
          ))}
        </div>
      </div>
      
      <div class="dont-pay__child right desktop">
        <div class="title-block">
          <h2 class="title"><p>{title}</p></h2>
          <div class="text-large description"><p set:html={description.replace(/\n/g, '<br />')} /></div>
        </div>
        <div class="pay-cards">
          <div class="pay-card pay-card-1"><img class="pay-card__image" src="/assets/img/card-1.png?ver=1.0.10.2" alt="Card 1"></div>
          <div class="pay-card pay-card-2"><img class="pay-card__image" src="/assets/img/card-2.png?ver=1.0.10.2" alt="Card 2"></div>
        </div>
        <div class="btn-wrapper">
          <button class="btn" modal="contact-form">
            <div class="btn__text">
              <div class="btn__text-up">{cta_text}</div>
              <div class="btn__text-static">{cta_text}</div>
            </div>
            <div class="btn__bg"></div>
          </button>
        </div>
      </div>

      <div class="dont-pay__child right mobile">
        <div class="title-block">
          <h2 class="title"><p set:html={title.replace(/\n/g, '<br />')} /></h2>
          <div class="text-large description"><p set:html={description.replace(/\n/g, '<br />')} /></div>
          <button class="btn" modal="contact-form">
            <div class="btn__text">
              <div class="btn__text-up">{cta_text}</div>
              <div class="btn__text-static">{cta_text}</div>
            </div>
            <div class="btn__bg"></div>
          </button>
        </div>
        <div class="pay-cards">
          <div class="pay-card pay-card-1"><img class="pay-card__image" src="/assets/img/card-1.png" alt="Card 1"></div>
          <div class="pay-card pay-card-2"><img class="pay-card__image" src="/assets/img/card-2.png" alt="Card 2"></div>
        </div>
      </div>

      <div class="dont-pay__child left mobile">
        {cards.map((card) => (
          <div class={`info-card info-card_${card.type}`} gsap-card="dont-pay-row-1">
            <div class="info-card__icon">
              <div class="info-card__icon-blur"></div>
              <div class="info-card__icon-image"><img src={card.icon} alt={card.title}></div>
            </div>
            <h3 class="h3 info-card__title"><p set:html={card.title.replace(/\n/g, '<br />')} /></h3>
            <div class="info-card__text"><p set:html={card.text.replace(/\n/g, '<br />')} /></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
)}
